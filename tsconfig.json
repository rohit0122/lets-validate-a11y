{
    "compilerOptions": {
        "allowImportingTsExtensions": true,
        // Generate d.ts files
        "declaration": true,
        // This compiler run should
        // only output d.ts files
        "emitDeclarationOnly": true,
        "esModuleInterop": true,
        "module": "esnext",
        "moduleResolution": "node",
        "outDir": "dist",
        "sourceMap": true,
        "target": "es6"
    },
    "lib": [
        "es2016"
    ]
}